APP_NAME="Smart Dispenser"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://api.smartdispenser.local

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_dispenser
DB_USERNAME=smart_dispenser
DB_PASSWORD=change_me

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# ---------------------------------------------------------------------------
# Xendit
# ---------------------------------------------------------------------------
XENDIT_SECRET_KEY=xnd_production_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_CALLBACK_TOKEN=replace_with_dashboard_verification_token

# ---------------------------------------------------------------------------
# MQTT Broker (shared with ESP32 firmware)
# ---------------------------------------------------------------------------
MQTT_HOST=mqtt.smartdispenser.local
MQTT_PORT=8883
MQTT_CLIENT_ID_PREFIX=laravel-backend
MQTT_USERNAME=backend_service
MQTT_PASSWORD=change_me
MQTT_USE_TLS=true
MQTT_TLS_VERIFY_PEER=true
MQTT_TLS_VERIFY_PEER_NAME=true
MQTT_TLS_ALLOW_SELF_SIGNED=false
MQTT_TLS_CA_FILE=

# ---------------------------------------------------------------------------
# Smart Dispenser App Defaults (overridable at runtime via `settings` table)
# ---------------------------------------------------------------------------
DISPENSER_QRIS_EXPIRY_SECONDS=120
DISPENSER_PRICE_PER_ML_NORMAL=3
DISPENSER_PRICE_PER_ML_DINGIN=5
DISPENSER_PRICE_PER_ML_PANAS=5
